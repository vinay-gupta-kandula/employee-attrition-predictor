# ==============================================================================
# Environment Configuration for Employee Attrition Predictor & Explainer API
# ==============================================================================

# Path to the serialized trained classifier (.joblib)
MODEL_PATH=models/attrition_model.joblib

# Path to the serialized scikit-learn preprocessing ColumnTransformer (.joblib)
PREPROCESSOR_PATH=models/preprocessor.joblib

# Network host address and port for the FastAPI uvicorn server
HOST=0.0.0.0
PORT=8000

# Application environment: development, staging, or production
ENVIRONMENT=production
